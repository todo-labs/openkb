---
import type { DocsConfig } from '../../lib/config';
import type { NavTab } from '../../lib/config';

interface Props {
  config: DocsConfig;
  currentSlug: string;
  activeTab?: NavTab;
}

const { config, currentSlug, activeTab } = Astro.props;
const hasTabs = config.navigation.tabs && config.navigation.tabs.length > 0;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand / Logo -->
    <div class="flex items-center gap-6">
      <a href={config.logo?.href || '/'} class="flex items-center gap-2.5 no-underline">
        {config.logo?.light ? (
          <img src={config.logo.light} alt={config.name} class="h-7 w-auto dark:hidden" />
        ) : null}
        {config.logo?.dark ? (
          <img src={config.logo.dark} alt={config.name} class="hidden h-7 w-auto dark:block" />
        ) : null}
        {!config.logo?.light && !config.logo?.dark ? (
          <div
            class="flex h-7 w-7 items-center justify-center rounded-lg text-white font-bold text-sm shadow-sm"
            style="background-color: var(--primary-color, #10b981);"
          >
            OK
          </div>
        ) : null}
        <span class="text-base font-bold text-slate-900 dark:text-slate-100">
          {config.name}
        </span>
      </a>

      <!-- Horizontal Tabs Navigation if present -->
      {hasTabs && (
        <nav class="hidden md:flex items-center gap-1 ml-4 border-l border-slate-200 pl-4 dark:border-slate-800">
          {config.navigation.tabs!.map((tab) => {
            const isActive = activeTab?.tab === tab.tab;
            const firstPage = tab.pages?.[0] || tab.groups?.[0]?.pages?.[0];
            const href = tab.href || (typeof firstPage === 'string' ? `/${firstPage.replace(/^\//, '').replace(/\.mdx?$/, '')}` : '/');

            return (
              <a
                href={href}
                style={isActive ? "color: var(--primary-color, #10b981);" : undefined}
                class={`rounded-md px-3 py-1.5 text-sm font-medium transition-colors ${
                  isActive
                    ? 'bg-slate-100 font-semibold dark:bg-slate-800'
                    : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50 dark:text-slate-400 dark:hover:text-slate-200 dark:hover:bg-slate-900'
                }`}
              >
                {tab.tab}
              </a>
            );
          })}
        </nav>
      )}
    </div>

    <!-- Actions: Search, Links, Theme Toggle -->
    <div class="flex items-center gap-3">
      <!-- Search Trigger Button -->
      <button
        type="button"
        id="openkb-search-trigger"
        class="flex h-9 w-48 sm:w-64 items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs text-slate-500 hover:border-slate-300 hover:bg-slate-100 transition dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:border-slate-700"
      >
        <span class="flex items-center gap-2">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Search docs...</span>
        </span>
        <kbd class="hidden sm:inline-block rounded bg-slate-200 px-1.5 py-0.5 font-mono text-[10px] text-slate-600 dark:bg-slate-800 dark:text-slate-400">
          ⌘K
        </kbd>
      </button>

      <!-- Navbar Links -->
      {config.navbar?.links && config.navbar.links.length > 0 && (
        <div class="hidden lg:flex items-center gap-4 border-l border-slate-200 pl-4 dark:border-slate-800">
          {config.navbar.links.map((link) => (
            <a
              href={link.href}
              target={link.target}
              rel={link.target === '_blank' ? 'noopener noreferrer' : undefined}
              class="text-sm font-medium text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200"
            >
              {link.label}
            </a>
          ))}
        </div>
      )}

      <!-- Primary CTA button -->
      {config.navbar?.primary && (
        <a
          href={config.navbar.primary.href}
          style="background-color: var(--primary-color, #10b981);"
          class="hidden sm:inline-flex items-center justify-center rounded-lg px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm hover:opacity-90 transition"
        >
          {config.navbar.primary.label}
        </a>
      )}

      <!-- Theme Switcher -->
      <button
        type="button"
        id="theme-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-100 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-900 transition"
        title="Toggle color theme"
      >
        <svg class="h-4 w-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg class="hidden h-4 w-4 dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark' || document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.removeAttribute('data-theme');
        document.documentElement.classList.remove('dark');
        localStorage.setItem('openkb-theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        document.documentElement.classList.add('dark');
        localStorage.setItem('openkb-theme', 'dark');
      }
    });
  }
</script>
